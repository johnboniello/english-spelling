<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/progressView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp"
            android:text=""
            android:textColor="#1A1A1A"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/listenRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <Button
                android:id="@+id/listenBtn"
                style="@style/Widget.Dictee.Button.Blue"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:text="🔊  Hear the word"
                android:textSize="20sp" />

            <Button
                android:id="@+id/slowBtn"
                style="@style/Widget.Dictee.Button.BluePale"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="🐢  Slow"
                android:textAllCaps="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="Add some words first (“Manage Words”)."
            android:textColor="#1A1A1A"
            android:textSize="16sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/instructionView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:paddingBottom="4dp"
            android:text="Pick the right spelling:"
            android:textColor="#1A1A1A"
            android:textSize="15sp" />

        <Button
            android:id="@+id/opt0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text=""
            android:textAllCaps="false"
            android:textSize="20sp" />

        <Button
            android:id="@+id/opt1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text=""
            android:textAllCaps="false"
            android:textSize="20sp" />

        <Button
            android:id="@+id/opt2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text=""
            android:textAllCaps="false"
            android:textSize="20sp" />

        <Button
            android:id="@+id/opt3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text=""
            android:textAllCaps="false"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/feedbackView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="14dp"
            android:paddingBottom="4dp"
            android:text=""
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/nextBtn"
            style="@style/Widget.Dictee.Button.Blue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="➡️  Next word"
            android:textAllCaps="false"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
