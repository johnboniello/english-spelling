<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Force a light look everywhere: this is a children's app and it must stay
         readable even when the phone is in dark mode / has "force dark" on. -->
    <style name="Theme.EnglishSpelling" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/blue</item>
        <item name="colorPrimaryDark">@color/blue_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/blue</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:windowBackground">@color/bg_app</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_soft</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>

        <!-- Andika everywhere: easy-to-distinguish capitals for young readers. -->
        <item name="android:fontFamily">@font/andika</item>
        <item name="fontFamily">@font/andika</item>

        <!-- Soft, rounded buttons everywhere by default. -->
        <item name="materialButtonStyle">@style/Widget.Dictee.Button</item>
    </style>

    <!-- Default button: rounded, roomy, tricolor "blue" fill. Individual buttons
         override backgroundTint / textColor via the styles below. -->
    <style name="Widget.Dictee.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:fontFamily">@font/andika</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="backgroundTint">@color/tri_blue</item>
        <item name="android:textColor">@color/tri_blue_on</item>
        <item name="rippleColor">#33042C53</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <!-- Uniform box: same height whether the label wraps to two lines or not,
             and no hidden inset so side-by-side buttons line up exactly. -->
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">2</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Dictee.Button.Blue">
        <item name="backgroundTint">@color/tri_blue</item>
        <item name="android:textColor">@color/tri_blue_on</item>
    </style>

    <style name="Widget.Dictee.Button.Red">
        <item name="backgroundTint">@color/tri_red</item>
        <item name="android:textColor">@color/tri_red_on</item>
        <item name="rippleColor">#33501313</item>
    </style>

    <style name="Widget.Dictee.Button.Gold">
        <item name="backgroundTint">@color/tri_gold</item>
        <item name="android:textColor">@color/tri_gold_on</item>
        <item name="rippleColor">#33633806</item>
    </style>

    <!-- Paler utility buttons with a hairline outline. -->
    <style name="Widget.Dictee.Button.Pale" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:fontFamily">@font/andika</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">2</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Dictee.Button.BluePale" parent="Widget.Dictee.Button.Pale">
        <item name="backgroundTint">@color/tri_blue_pale</item>
        <item name="android:textColor">@color/tri_blue_pale_on</item>
        <item name="strokeColor">@color/tri_blue_pale_stroke</item>
        <item name="rippleColor">#220C447C</item>
    </style>

    <style name="Widget.Dictee.Button.RedPale" parent="Widget.Dictee.Button.Pale">
        <item name="backgroundTint">@color/tri_red_pale</item>
        <item name="android:textColor">@color/tri_red_pale_on</item>
        <item name="strokeColor">@color/tri_red_pale_stroke</item>
        <item name="rippleColor">#22791F1F</item>
    </style>
</resources>
