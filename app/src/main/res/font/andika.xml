<?xml version="1.0" encoding="utf-8"?>
<!-- Andika (SIL, OFL): designed for early readers, with capitals that are easy
     to tell apart from lowercase (c/C, o/O, s/S...). Subset to Latin glyphs. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font android:fontStyle="normal" android:fontWeight="400" android:font="@font/andika_regular" />
    <font android:fontStyle="normal" android:fontWeight="700" android:font="@font/andika_bold" />
</font-family>
